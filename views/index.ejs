<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>n11's trcklst ctrl</title>

    <link rel="stylesheet" href="style.css">
  </head>

  <body>
    <div class="container">
      <form action="/tracks" method="POST">
        <h1 class=pen>n11's trcklst ctrl</h1>
        <p><span>*</span> is required.</p>

        <input type="text" required placeholder="Track*" name="track" />
        <input type="text" required placeholder="Artist*" name="artist" />
        <input type="text" required placeholder="Album*" name="album" />
        <input type="text" required placeholder="Duration*" name="duration" />

        <button type="submit">Submit</button>
      </form>
    </div>

    <div class="tracklist">
      <h1>Tracklist</h1>
      <ul>
        <li class="header">
          <div class="track-info">
            <span>Title</span>
            <span>Artist</span>
            <span>Album</span>
            <span>Duration</span>
          </div>
          <div class="track-actions"></div>
        </li>

        <% for(var i = 0; i < tracks.length; i++) { %>
          <li>
            <div class="track-info">
              <span class="track-name"><%= tracks[i].track %></span>
              <span class="track-artist"><%= tracks[i].artist %></span>
              <span class="track-album italic"><%= tracks[i].album %></span>
              <span class="track-duration"><%= tracks[i].duration %></span>
            </div>
            <div class="track-actions">
              <button class="edit-button">✎</button>
              <button class="delete-button">✖</button>
            </div>
          </li>
        <% } %>
      </ul>
    </div>
    <script src="/main.js"></script>
  </body>
</html>