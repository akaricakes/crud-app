<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>MY APP</title>
  </head>

  <body>
    <h1>May Node and Express be with you.</h1>

    <form action="/tracks" method="POST">
      <input type="text" placeholder="name" name="name" />
      <input type="text" placeholder="track" name="track" />
      <button type="submit">Submit</button>
    </form>

    <h2>Tracklist</h2>

    <ul class="tracks">
      <% for(var i = 0; i < tracks.length; i++) { %>
        <li class="track">
          <span><%= tracks[i].name %></span>:
          <span><%= tracks[i].track %></span>
        </li>
      <% } %>
    </ul>

    <div>
      <h2>Darth Vader invades!</h2>
      <p>Replaces a random track from the tracklist!</p>
      <button id="update-button">Replace a random track</button>
    </div>

    <div>
      <h2>Remove last track!</h2>
      <button id="delete-button">Delete the last track</button>
    </div>
    <div id="message"></div>

    <script src="/main.js"></script>
  </body>
</html>